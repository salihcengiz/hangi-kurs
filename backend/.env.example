# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection.
#
# Format:  postgresql://KULLANICI:SIFRE@localhost:5432/VERITABANI
# Replace only SIFRE with your local postgres password — leave `postgres:` in
# place, it is the username. You do NOT need to create the database by hand;
# `npm run db:migrate` creates it if it is missing.
DATABASE_URL="postgresql://postgres:SIFRE@localhost:5432/hangi-kurs"

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Firebase Admin — SERVICE ACCOUNT (OPTIONAL, and secret)
#
# These VERIFY tokens. The credentials that sign users in are a different set,
# and they live in frontend/.env. Do not mix the two up.
#
# Leave these blank to run without authentication — the API still serves all
# public data and the frontend shows a disabled sign-in button. Fill them in
# only when you want sign-in to work.
#
# Values come from: Firebase Console > Project settings > Service accounts >
# "Generate new private key" (downloads a JSON file).
#   project_id   -> FIREBASE_PROJECT_ID
#   client_email -> FIREBASE_CLIENT_EMAIL
#   private_key  -> FIREBASE_PRIVATE_KEY
#
# FIREBASE_PRIVATE_KEY must be:
#   - on ONE line
#   - wrapped in DOUBLE quotes  <- this part is not optional
#   - with the \n sequences left exactly as they appear in the JSON
# dotenv turns those \n into real newlines only for double-quoted values. Paste
# it unquoted and the PEM parser rejects the key with an opaque error.
#
# This key grants admin access to your Firebase project. Never commit it, never
# paste it into a chat or an issue. If it leaks, revoke it in the console.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
