# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# These are the Firebase **web app** credentials — a different set from the ones
# in backend/.env. Do not mix them up:
#
#   frontend/.env  -> web app config, signs the user IN     (this file)
#   backend/.env   -> service account, VERIFIES the token   (secret!)
#
# Unlike the backend service account, these values are NOT secret. Vite inlines
# every VITE_* variable into the JavaScript bundle, so anyone can read them in
# the browser. That is how Firebase is designed to work: access is controlled by
# the Authorized domains list and your security rules, not by hiding this config.
#
# Where to find them:
#   Firebase Console > Project settings > General > Your apps > Web app > SDK
#   setup and configuration > Config
#
# Leave everything blank to run without authentication. The app works fine —
# all data is public in v1 — and the sign-in button renders disabled.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL for the API. Leave blank in development — Vite proxies /api to the
# backend on port 4000, so no absolute URL is needed.
VITE_API_BASE_URL=
